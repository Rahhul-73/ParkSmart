# ─── App ───
NODE_ENV=development
PORT=5001

# ─── MongoDB ───
MONGO_URI=mongodb://localhost:27017/parking_system

# ─── JWT Secrets ───
JWT_ACCESS_SECRET=parksmart_jwt_access_secret_token_key_dev_2026_xyz
JWT_REFRESH_SECRET=parksmart_jwt_refresh_secret_token_key_dev_2026_xyz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ───
CLIENT_URL=http://localhost:5173

# ─── Email (Nodemailer) ───
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user@example.com
SMTP_PASS=ethereal_pass
EMAIL_FROM="ParkSmart <noreply@parksmart.io>"

# ─── Multer Uploads ───
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
